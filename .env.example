# FireSense Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Mode: development, demo, production
APP_MODE=development

# Database Configuration (PostgreSQL/PostGIS)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/firesense

# JWT Authentication Secrets (Never commit actual production keys)
JWT_SECRET_KEY=firesense-dev-secret-key-change-in-production-32bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
