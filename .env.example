# FireSense Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# docker compose reads these from your shell environment or .env automatically.
# NEVER commit real credentials; /api/live etc. fail closed when these are unset.

# Application Mode: development, demo, production
APP_MODE=development

# Database Configuration (PostgreSQL/PostGIS) — REQUIRED
DATABASE_URL=postgresql+psycopg://postgres:ch4nge-me@localhost:5432/firesense

# JWT Authentication Secret — REQUIRED, no default. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Legacy demo server (app.py, deployed on Vercel) — REQUIRED for demo login.
# FIRESENSE_DEMO_PASSWORD gates the demo accounts; FIRESENSE_TOKEN_SECRET signs
# the stateless tokens. With either unset, login returns 503 (auth closed).
FIRESENSE_DEMO_PASSWORD=
FIRESENSE_TOKEN_SECRET=

# Optional: bootstrap users from JSON when the FastAPI users table is empty.
# Format: [{"email":"...","password":"...","role":"analyst|authority|responder|admin","full_name":"..."}]
FIRESENSE_BOOTSTRAP_USERS=

# NASA FIRMS map key — REQUIRED for /api/live (never pass it as a query param)
FIRMS_MAP_KEY=

# docker compose database service only:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=firesense

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173